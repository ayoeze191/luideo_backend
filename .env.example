# Copy to .env and fill in. Only DATABASE_URL and SESSION_SECRET are needed to
# boot; every integration below switches itself off until its keys are set.

NODE_ENV=development
PORT=4000

# Where the API is reachable, and where the storefront lives. Used for payment
# redirects, email links and CORS.
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# Extra allowed browser origins, comma-separated (e.g. Vercel preview URLs).
CORS_ORIGINS=

DATABASE_URL="postgresql://luideo:luideo@localhost:5433/luideo?schema=public"

# Any long random string: `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=30
# "lax" when API and shop share a site (api.luideo.com + luideo.com).
# "none" only if they are on unrelated domains (requires HTTPS).
COOKIE_SAMESITE=lax
# e.g. .luideo.com — leave blank in development.
COOKIE_DOMAIN=

# --- Google sign-in -------------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
GOOGLE_CLIENT_ID=

# --- Email (verification, password reset, receipts, new-piece alerts) -----
# Resend (resend.com → API Keys). When set, all email goes through Resend.
# MAIL_FROM must use a domain verified in Resend → Domains. Until one is,
# only "onboarding@resend.dev" works, and only to your own Resend account email.
RESEND_API_KEY=
MAIL_FROM="Lui'Deo <hello@luideo.com>"
# Or SMTP instead of Resend. Leave both blank in development: emails are
# printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where contact-form messages and new-order notices go.
STUDIO_EMAIL=hello@luideo.com

# --- Payments (Paystack: NGN and USD) -----------------------------------
# Dashboard → Settings → API Keys & Webhooks. Use sk_test_… while testing.
PAYSTACK_SECRET_KEY=
# USD must be enabled on your Paystack account first; until then set this to NGN.
PAYSTACK_CURRENCIES=NGN,USD

# --- Instagram & Threads publishing --------------------------------------
# developers.facebook.com → your app. Both use this redirect URL:
#   <API_URL>/api/admin/social/callback
# Instagram: Use cases → Instagram → "API setup with Instagram login".
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0
# Threads: Use cases → "Access the Threads API" → Settings.
THREADS_APP_ID=
THREADS_APP_SECRET=

# --- Photo uploads -------------------------------------------------------
# cloudinary://API_KEY:API_SECRET@CLOUD_NAME (Cloudinary dashboard → API Keys).
# Blank = save to ./uploads on this server (fine locally, not on most hosts).
CLOUDINARY_URL=

# --- First admin (used by `npm run db:seed`) ------------------------------
ADMIN_EMAIL=admin@luideo.test
ADMIN_PASSWORD=1234567
ADMIN_NAME="Lui'Deo Studio"
